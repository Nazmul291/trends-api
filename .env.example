SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_metaobject_definitions,write_metaobjects,write_products,read_locations,write_inventory,read_inventory
SHOPIFY_APP_URL=https://dev.nazmulcodes.org
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/trends_api?schema=public"

# ==========================================
# Caching Configuration
# ==========================================
# Standard Redis (Docker / Fly.io / Railway / Local)
REDIS_URL="redis://localhost:6379"

# Optional: Serverless Upstash / Vercel KV REST API
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ==========================================
# TRENDS API Regional Credentials
# ==========================================
# Supply your Bearer Token for each region (nz, au, sg)
TRENDS_API_KEY_NZ=
TRENDS_API_KEY_AU=
TRENDS_API_KEY_SG=

# Fallback generic token (used if region-specific token is empty)
TRENDS_API_KEY=

# Enable realistic mock fallback data in dev mode if API keys are not yet configured
ENABLE_TRENDS_MOCK_FALLBACK=true

# ==========================================
# Upstash QStash (background sync job queue)
# ==========================================
# Dispatches Shopify product/variant syncs as durable HTTP messages instead of an
# in-request background promise, so they survive the Vercel function freezing right
# after the HTTP response is sent. Get these from https://console.upstash.com/qstash
#
# Free tier is capped at 500 messages/day: we publish exactly ONE consolidated
# message per sync-product request (never one per variant) to stay well under it.
QSTASH_TOKEN=
# Optional: only needed to point at a custom/self-hosted QStash endpoint
# (e.g. the local `qstash dev` CLI). Leave unset to use Upstash's default.
# QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
