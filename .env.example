SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_metaobject_definitions,write_metaobjects,write_products
SHOPIFY_APP_URL=https://dev.nazmulcodes.org
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trends_api?schema=public"

# ==========================================
# TRENDS API Regional Credentials
# ==========================================
# Supply your Bearer Token for each region (nz, au, sg)
TRENDS_API_KEY_NZ=
TRENDS_API_KEY_AU=
TRENDS_API_KEY_SG=

# Fallback generic token (used if region-specific token is empty)
TRENDS_API_KEY=

# Enable realistic mock fallback data in dev mode if API keys are not yet configured
ENABLE_TRENDS_MOCK_FALLBACK=true
