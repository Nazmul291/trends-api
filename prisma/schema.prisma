// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model TrendProductSync {
  id               String             @id @default(uuid())
  shop             String
  shopifyProductId String             @unique
  trendsCode       String
  region           String
  syncLocks        String[]           @default([])
  // Per-product Inventory Distribution Override
  inventorySyncMode String?
  targetLocationId  String?
  splitLocationIds  String[]           @default([])
  lastSyncedAt     DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  variants         TrendVariantSync[]

  @@index([shop, trendsCode])
}

model TrendVariantSync {
  id               String           @id @default(uuid())
  productSyncId    String
  shopifyVariantId String           @unique
  inventoryItemId  String?
  stockCode        String
  region           String
  lastStockQty     Int              @default(0)
  updatedAt        DateTime         @updatedAt

  productSync      TrendProductSync @relation(fields: [productSyncId], references: [id], onDelete: Cascade)

  @@index([stockCode, region])
  @@index([inventoryItemId])
}

model TrendOrderDispatch {
  id               String   @id @default(uuid())
  shop             String
  shopifyOrderId   String   @unique
  trendsOrderNum   String?
  region           String
  status           String   @default("pending")
  payload          Json
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop, status])
}

/// Per-shop application settings — stores Trends API key, mock fallback flag, and enabled regions.
/// Falls back to environment variables when no DB record exists for a shop.
model AppSettings {
  id                      String   @id @default(uuid())
  shop                    String   @unique
  trendsApiKey            String?
  enableTrendsMockFallback Boolean  @default(true)
  enabledRegions          String[] @default(["nz", "au", "sg"])

  // Automated Background Sync Configuration
  autoSyncEnabled         Boolean  @default(true)
  syncFrequency           String   @default("daily")
  syncTime                String   @default("02:00")
  syncBatchSize           Int      @default(50)
  syncScope               String[] @default(["inventory", "price"])
  lastSyncedAt            DateTime?
  syncStatus              String   @default("idle")
  syncErrorMessage        String?

  // Inventory Location Strategy
  inventorySyncMode       String   @default("single")
  targetLocationId        String?
  splitLocationIds        String[] @default([])

  // Stateful Chunk Cursor for Vercel Cron
  currentSyncPage         Int      @default(1)
  totalCatalogPages       Int      @default(1)
  syncCursorStatus        String   @default("idle")
  lastChunkProcessedAt    DateTime?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

