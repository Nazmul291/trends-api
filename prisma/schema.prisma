// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model TrendProductSync {
  id               String             @id @default(uuid())
  shop             String
  shopifyProductId String             @unique
  trendsCode       String
  region           String
  syncLocks        String[]           @default([])
  // Per-product Inventory Distribution Override
  inventorySyncMode String?
  targetLocationId  String?
  splitLocationIds  String[]           @default([])

  // Per-product Pricing & Margin Override — null means "use the shop-wide
  // AppSettings default" (resolved in syncTrendProductToShopify via
  // shared/utils/pricing-engine.ts's computeTierPricing()).
  /// Per-quantity-tier markup % overrides, e.g. {"100": 35, "5000": 25} —
  /// keyed by tier quantity as a string (JSON object keys are always
  /// strings). A tier missing from this map falls back to
  /// AppSettings.defaultMarkupPercent, not to any other tier's value.
  tierMarkups              Json?
  includeSetupInUnitCost   Boolean?
  shippingBufferOverride   Float?
  /// Which pricing.additional_costs[].id (from the Trends API) supplies this
  /// product's print/setup cost — null means no branding option selected yet
  /// (defaults to a Screen Print match if one exists; see
  /// shared/utils/pricing-engine.ts's findDefaultAdditionalCost()).
  selectedAdditionalCostId Int?

  lastSyncedAt     DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  variants         TrendVariantSync[]

  @@index([shop, trendsCode])
}

model TrendVariantSync {
  id               String           @id @default(uuid())
  productSyncId    String
  shopifyVariantId String           @unique
  inventoryItemId  String?
  stockCode        String
  region           String
  lastStockQty     Int              @default(0)
  updatedAt        DateTime         @updatedAt

  productSync      TrendProductSync @relation(fields: [productSyncId], references: [id], onDelete: Cascade)

  @@index([stockCode, region])
  @@index([inventoryItemId])
}

model TrendOrderDispatch {
  id               String   @id @default(uuid())
  shop             String
  shopifyOrderId   String   @unique
  trendsOrderNum   String?
  region           String
  status           String   @default("pending")
  payload          Json
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop, status])
}

/// Per-shop application settings — stores Trends API key, mock fallback flag, and enabled regions.
/// Falls back to environment variables when no DB record exists for a shop.
model AppSettings {
  id                      String   @id @default(uuid())
  shop                    String   @unique
  trendsApiKey            String?
  enableTrendsMockFallback Boolean  @default(true)
  enabledRegions          String[] @default(["nz", "au", "sg"])

  // Automated Background Sync Configuration
  autoSyncEnabled         Boolean  @default(true)
  syncFrequency           String   @default("daily")
  syncTime                String   @default("02:00")
  syncBatchSize           Int      @default(50)
  syncScope               String[] @default(["inventory", "price"])
  lastSyncedAt            DateTime?
  syncStatus              String   @default("idle")
  syncErrorMessage        String?

  // Inventory Location Strategy
  inventorySyncMode       String   @default("single")
  targetLocationId        String?
  splitLocationIds        String[] @default([])

  // Stateful Chunk Cursor for Vercel Cron
  currentSyncPage         Int      @default(1)
  totalCatalogPages       Int      @default(1)
  syncCursorStatus        String   @default("idle")
  lastChunkProcessedAt    DateTime?

  // Pricing & Margin Defaults — shop-wide fallback used by computeTierPricing()
  // (shared/utils/pricing-engine.ts) whenever a product has no per-product
  // override set on its TrendProductSync row.
  defaultMarkupPercent          Float   @default(35)
  defaultIncludeSetupInUnitCost Boolean @default(true)
  defaultShippingBufferPerUnit  Float   @default(0.15)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// One active dynamic, single-use volume-pricing discount code per cart.
/// Standard (non-Plus) plans can't register the tiered-discount-function as a
/// live automatic discount, so this is the fallback: the storefront script
/// re-evaluates the cart on every mutation and this table tracks whichever
/// code is currently live for that cart, so it can be looked up and deleted
/// from Shopify the instant the cart changes again.
model VolumeDiscountCode {
  id                String   @id @default(uuid())
  shop              String
  cartToken         String
  discountNodeId    String
  code              String
  amount            String
  /// The cart-wide quantity this code's amount/minimumRequirement was computed against —
  /// lets syncCartDiscount detect "nothing actually changed" and skip re-issuing a code.
  totalCartQuantity Int
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, cartToken])
  @@index([expiresAt])
}

model TrendSyncJob {
  id           String    @id @default(uuid())
  shop         String
  trendsCode   String
  region       String
  status       String    @default("QUEUED") // QUEUED, IN_PROGRESS, COMPLETED, FAILED
  stage        String    @default("QUEUED") // STAGE_1_PRODUCT_VARIANTS, STAGE_2_MEDIA_LINKING, STAGE_3_INVENTORY_DISTRIBUTION, COMPLETED, FAILED
  progress     Int       @default(0) // 0-100%
  message      String?
  errorMessage String?
  result       Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shop, trendsCode])
  @@index([shop, status])
  @@index([createdAt])
}

